<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootMain"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_page_light"
    android:fitsSystemWindows="true">

    <androidx.camera.view.PreviewView
        android:id="@+id/previewView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="top"
        android:layout_marginTop="52dp"
        android:layout_marginBottom="116dp"
        app:scaleType="fillCenter" />

    <View
        android:id="@+id/focusIndicator"
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:background="@drawable/bg_focus_ring"
        android:visibility="gone" />

    <FrameLayout
        android:id="@+id/headerBar"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_gravity="top"
        android:background="@drawable/bg_top_bar"
        android:paddingStart="8dp"
        android:paddingEnd="8dp">

        <ImageButton
            android:id="@+id/btnFlash"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_gravity="start|center_vertical"
            android:background="@drawable/bg_header_icon_button"
            android:contentDescription="闪光灯"
            android:padding="10dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_flash_line" />

        <ImageView
            android:id="@+id/ivHeaderLogo"
            android:layout_width="198dp"
            android:layout_height="34dp"
            android:layout_gravity="center"
            android:adjustViewBounds="true"
            android:contentDescription="项目Logo"
            android:scaleType="fitCenter"
            android:src="@drawable/header_project_logo" />

        <ImageButton
            android:id="@+id/btnSettings"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_gravity="end|center_vertical"
            android:background="@drawable/bg_header_icon_button"
            android:contentDescription="设置"
            android:padding="10dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_settings_gear_line" />
    </FrameLayout>

    <LinearLayout
        android:id="@+id/zoomPanel"
        android:layout_width="wrap_content"
        android:layout_height="36dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="62dp"
        android:layout_marginEnd="10dp"
        android:visibility="gone"
        android:background="@drawable/bg_zoom_panel"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="8dp">

        <TextView
            android:id="@+id/tvZoomRatio"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="46dp"
            android:gravity="center"
            android:text="1.0x"
            android:textColor="@color/yf_ink"
            android:textSize="14sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnZoomReset"
            android:layout_width="46dp"
            android:layout_height="30dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_soft_button"
            android:minHeight="0dp"
            android:minWidth="0dp"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:text="1x"
            android:textAllCaps="false"
            android:textColor="@color/yf_blue"
            android:textSize="13sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/watermarkContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginStart="6dp"
        android:layout_marginEnd="6dp"
        android:layout_marginBottom="152dp"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/ivLogo"
            android:layout_width="168dp"
            android:layout_height="63dp"
            android:layout_gravity="start"
            android:adjustViewBounds="true"
            android:background="@android:color/transparent"
            android:contentDescription="水印图标"
            android:padding="0dp"
            android:scaleType="fitCenter"
            android:src="@drawable/default_watermark_logo" />

        <LinearLayout
            android:id="@+id/watermarkInfoCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="@android:color/transparent"
            android:orientation="vertical"
            android:paddingStart="2dp"
            android:paddingTop="2dp"
            android:paddingEnd="2dp"
            android:paddingBottom="2dp">

            <TextView
                android:id="@+id/tvTimePreview"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clickable="true"
                android:focusable="true"
                android:lineSpacingExtra="2dp"
                android:text="时间加载中..."
                android:textColor="#FFFFFFFF"
                android:textSize="14sp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/locationTextArea"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clickable="true"
                android:focusable="true"
                android:orientation="vertical"
                android:paddingTop="3dp"
                android:paddingBottom="3dp">

                <TextView
                    android:id="@+id/tvLocationPreview"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:lineSpacingExtra="2dp"
                    android:text="位置: 正在获取周边地点..."
                    android:textColor="#FFFFFFFF"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/tvCoordPreview"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:lineSpacingExtra="2dp"
                    android:text="经纬度获取中"
                    android:textColor="#FFFFFFFF"
                    android:textSize="15sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvProjectPreview"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:lineSpacingExtra="2dp"
                android:textColor="#FFFFFFFF"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/bottomBar"
        android:layout_width="match_parent"
        android:layout_height="116dp"
        android:layout_gravity="bottom"
        android:background="@drawable/bg_bottom_bar"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:paddingTop="12dp"
        android:paddingEnd="20dp"
        android:paddingBottom="14dp">

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1">

            <ImageButton
                android:id="@+id/btnAlbum"
                android:layout_width="62dp"
                android:layout_height="62dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_album_thumb"
                android:contentDescription="打开相册"
                android:padding="2dp"
                android:scaleType="centerCrop"
                android:src="@drawable/app_logo" />
        </FrameLayout>

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1">

            <Button
                android:id="@+id/btnPhoto"
                android:layout_width="78dp"
                android:layout_height="78dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_photo_button"
                android:minHeight="0dp"
                android:minWidth="0dp"
                android:text=""
                android:textColor="#000000" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1.45"
            android:gravity="center"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnVideo"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:background="@drawable/bg_record_button"
                android:contentDescription="开始录像"
                android:minHeight="0dp"
                android:minWidth="0dp"
                android:text="录"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold" />

            <ImageButton
                android:id="@+id/btnSwitchCamera"
                android:layout_width="54dp"
                android:layout_height="54dp"
                android:layout_marginStart="10dp"
                android:background="@drawable/bg_header_icon_button"
                android:contentDescription="切换前后镜头"
                android:padding="12dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_camera_switch_line" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
