<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <layer-list>
            <item>
                <shape android:shape="oval">
                    <solid android:color="#FFF5F8FC" />
                    <stroke android:width="4dp" android:color="#FFCAD6E3" />
                </shape>
            </item>
            <item android:width="28dp" android:height="28dp" android:gravity="center">
                <shape android:shape="rectangle">
                    <corners android:radius="5dp" />
                    <solid android:color="#FFD94D45" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item>
        <layer-list>
            <item>
                <shape android:shape="oval">
                    <solid android:color="#FFFFFFFF" />
                    <stroke android:width="4dp" android:color="#FFCAD6E3" />
                </shape>
            </item>
            <item android:width="26dp" android:height="26dp" android:gravity="center">
                <shape android:shape="rectangle">
                    <corners android:radius="5dp" />
                    <solid android:color="#FFD94D45" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
